#!/bin/bash

alias grep='grep --color=auto'
alias zshrc='$EDITOR ~/.zshrc'
alias llha='ls -lha'
alias vim='nvim'

alias redis-cli="docker run -it --rm redis:alpine redis-cli -h host.docker.internal -p 6379"

tools() {
  docker compose -f "${DEVELOPMENT_TOOLS_PATH}/compose.yaml" "$@"
}

# Export a .env file into the current shell; a function, since a script cannot change its parent's env
envup() {
  local file="${1:-.env}"
  [[ -f "$file" ]] || { echo "No $file file found" >&2; return 1; }
  set -a
  source "$file"
  set +a
}

# Work
alias prepare-work-env='~/Work/prepare-work-env'
