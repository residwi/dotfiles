theme = Catppuccin Mocha

font-family = JetBrainsMono Nerd Font
font-size = 11
font-thicken = true
font-thicken-strength = 50
font-feature = -calt
window-inherit-font-size = false

cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor,sudo,title,ssh-env,ssh-terminfo
cursor-text = #000000
mouse-hide-while-typing = true

auto-update = check

# Desktop alert when a command over 5s finishes in an unfocused surface (1.3+).
# Needs shell integration, so it does not fire for shells inside tmux.
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify

# https://github.com/ghostty-org/ghostty/discussions/3470
# fix color issues on macOS
window-colorspace = display-p3

# Window Settings
window-width = 100
window-height = 30
window-padding-x = 5
window-padding-y = 2

# Titlebar Settings
macos-titlebar-style = tabs
gtk-titlebar-style = tabs

# Custom Keybinds (super == command key on mac)
# global means overrides all other apps
keybind = cmd+e=toggle_quick_terminal

# Fix general slow performance on Linux (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll
