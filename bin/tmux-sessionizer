#!/usr/bin/env sh

if [ $# -eq 1 ]; then
	selected=$1
else
	selected=$(find ~ ~/Work ~/Development/web -mindepth 1 -maxdepth 1 -type d | fzf)
fi

if [ -z "$selected" ]; then
	exit 0
fi

# tmux 3.7a+ keeps . and : in session names, but -t targets cannot address them
selected_name=$(basename "$selected" | tr .: __)

# "=" forces an exact match; plain -t foo also matches session foobar
if [ -z "$TMUX" ]; then
	tmux new-session -A -s "$selected_name" -c "$selected"
elif ! tmux has-session -t "=$selected_name" 2>/dev/null; then
	tmux new-session -ds "$selected_name" -c "$selected"\; switch-client -t "=$selected_name"
else
	tmux switch-client -t "=$selected_name"
fi
